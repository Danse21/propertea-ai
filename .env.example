# Backend (FastAPI + SQLAlchemy) — required.
# Matches docker-compose.yml's Postgres service (db "propertea", user
# postgres, password dev, port 5432). Copy this file to .env and adjust if
# your local Postgres runs somewhere else.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/propertea

# Frontend (Streamlit) — optional, defaults to http://localhost:8000 if unset.
# Only needs setting if the backend isn't on localhost:8000 (e.g. pointing a
# local frontend run at a deployed backend).
BACKEND_URL=http://localhost:8000
